# Local dev (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://massif:massif@localhost:5433/massif

# Anthropic API — used to extract structured statements from prose
# (arrêté PDFs, institutional bulletins). Not needed until the LLM
# extraction path is built.
ANTHROPIC_API_KEY=

# Sent with every outbound scrape request. Put a real contact URL here
# before pointing this at anyone's server.
USER_AGENT=massif/0.1 (+https://example.org/about; contact@example.org)

# Global politeness floor, seconds between requests to the same host
SCRAPE_MIN_INTERVAL=2.0
