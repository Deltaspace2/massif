# Local dev.
#   Docker  (docker compose up -d)          -> port 5433
#   Native  (scripts/setup_db_native.sh)    -> port 5432
DATABASE_URL=postgresql+psycopg://massif:massif@localhost:5433/massif

# Anthropic API — reads prose we already store into structured statements
# (arrêté bodies, institutional bulletins). Rules stay on the structured
# sources; this is only for text no regex can read.
#
# OPTIONAL, and left empty on purpose. With no key `build_extractor` returns
# None and any LLM-backed source is SKIPPED, the same way registry.py skips a
# source with no scraper — a run on a machine without a key completes rather
# than half-completing. Needs `pip install -e '.[llm]'` as well as a key.
#
# Every reading is cached in llm_cache on content + prompt version + model, so
# re-extracting stored documents costs nothing after the first pass. Nothing
# from this path can reach a status slot without a human: it is all written
# needs_review.
ANTHROPIC_API_KEY=

# Guards the review page at /admin/review on the API project — NOT on the
# public frontend, which exists to be crawled and should carry no login.
#
# EMPTY MEANS THE ADMIN ROUTES ARE NOT MOUNTED. Absent, never open: a missing
# secret that quietly becomes a public write endpoint is the failure that does
# not announce itself. Set it only on the API project.
#
# HTTP Basic, any username, this as the password — so a browser prompts and the
# secret stays out of the URL, out of history and out of referrers.
ADMIN_TOKEN=

# Sent with every outbound scrape request. Put a real contact URL here
# before pointing this at anyone's server.
USER_AGENT=massif/0.1 (+https://example.org/about; contact@example.org)

# Global politeness floor, seconds between requests to the same host
SCRAPE_MIN_INTERVAL=2.0
