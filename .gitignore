# .env* not .env: there was a .env.bak sitting here untracked, which one
# `git add -A` would have published. The negation keeps the template visible,
# and it is committed, so it must stay matchable.
.env*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
node_modules/
.next/
**/osm_candidates.yaml
data/
*.log
_to_delete/
*.tsbuildinfo
_bundle/

# Camera originals. Never in public/ — Next serves that directory verbatim,
# EXIF and all. Derived, stripped web assets go in public/backgrounds/.
photo-source/
*.tgz
